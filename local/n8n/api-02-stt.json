      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inp = $input.first();\nconst b = inp.json.body || inp.json || {};\nconst bin = inp.binary || {};\nconst f = bin.audio || bin.file || bin.data || Object.values(bin)[0];\nconst userId = (b.userId || '').toString();\nif (!/^WEB_[A-Za-z0-9_-]{1,64}$/.test(userId)) throw new Error('userId ไม่ถูกต้อง');\nif (!f) throw new Error('ไม่พบไฟล์เสียง (field audio)');\n// ส่ง binary object เดิมทั้งก้อน (ห้ามสร้างใหม่ — reference จะขาดแล้วได้ไฟล์ศูนย์)\nreturn [{ json: { userId: userId }, binary: inp.binary }];"
      }
    },
