    {
      "id": "d42df53e-8abd-47ab-bc6d-bb91f687ebbf",
      "name": "To Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const bin = $input.first().binary || {};\nconst f = bin.audio || bin.file || bin.data || Object.values(bin)[0];\nif (!f) return [{ json: { ok: false, error: 'TTS ไม่ตอบเป็นไฟล์เสียง' } }];\nconst buf = await this.helpers.getBinaryDataBuffer(0, Object.keys(bin).find(k => bin[k] === f) || 'data');\nif (!buf || !buf.length || buf.length < 1000) return [{ json: { ok: false, error: 'ไฟล์เสียงว่างเปล่า' } }];\nreturn [{ json: { ok: true, audio: buf.toString('base64'), mime: 'audio/wav', engine: 'piper' } }];"
      }
    },
