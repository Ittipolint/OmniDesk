    },
    {
      "id": "68c2c240-02bd-45b3-a472-940772e5b8b0",
      "name": "Build Insert SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $('Build Mute SQL').first().json;\nconst q = (s) => (s || '').toString().replace(/'/g, \"''\");\nconst body = (j.text !== '' && j.text !== undefined) ? j.text : ('[' + j.type + ']');\nconst sql = `INSERT INTO cd_messages (conversation_id, sender, content, message_type, media_url, media_preview_url, sticker_package, sticker_id, status, delivered_at, created_at) VALUES (${j.conversationId}, 'agent', '${q(body)}', '${j.type}', ${j.mediaUrl ? `'${q(j.mediaUrl.slice(0,500))}'` : 'NULL'}, ${j.mediaPreviewUrl ? `'${q(j.mediaPreviewUrl.slice(0,500))}'` : 'NULL'}, ${j.stickerPackage ? `'${q(j.stickerPackage.slice(0,50))}'` : 'NULL'}, ${j.stickerId ? `'${q(j.stickerId.slice(0,50))}'` : 'NULL'}, 'ok', NOW(), NOW()) RETURNING id`;\nreturn [{ json: { ...j, sql: sql } }];"
      }
    },
