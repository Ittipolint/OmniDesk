      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || $input.first().json || {};\nconst convId = parseInt(b.conversationId) || 0;\nif (!convId) throw new Error('missing conversationId');\nconst type = ['text','image','video','sticker'].includes(b.type) ? b.type : 'text';\nconst text = (b.text || '').toString().slice(0, 2000);\nif (type === 'text' && !text.trim()) throw new Error('กรุณาพิมพ์ข้อความ');\nif ((type === 'image' || type === 'video') && !(b.mediaUrl || '').toString().match(/^https?:\\/\\//i)) throw new Error('ไม่พบ URL ของไฟล์');\nif (type === 'sticker' && (!(b.stickerPackage || '') || !(b.stickerId || ''))) throw new Error('ข้อมูลสติกเกอร์ไม่ครบ');\nreturn [{ json: { conversationId: convId, type: type, text: text,\n  mediaUrl: (b.mediaUrl || '').toString(), mediaPreviewUrl: (b.mediaPreviewUrl || '').toString(),\n  stickerPackage: (b.stickerPackage || '').toString(), stickerId: (b.stickerId || '').toString() } }];"
      }
    },
    {
      "id": "e8d86726-ec60-4ef9-85e9-344ec86f8148",
      "name": "Build Mute SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json;\nreturn [{ json: { ...j, mute_sql: `UPDATE cd_conversations SET bot_enabled = 0 WHERE id = ${j.conversationId} AND bot_enabled = 1` } }];"
      }
    },
