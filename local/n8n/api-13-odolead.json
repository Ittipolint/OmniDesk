      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || $input.first().json || {};\nconst op = ((b.op || 'order').toString() === 'chat') ? 'chat' : 'order';\nconst out = { op: op, is_chat: (op === 'chat'), token: '__ODOO_SHARED_TOKEN__' };\nif (op === 'chat') {\n  out.channel = (b.channel || '').toString();\n  out.external_user_id = (b.external_user_id || b.userId || '').toString().slice(0, 128);\n  out.display_name = (b.display_name || '').toString().slice(0, 120);\n  out.text = (b.text || '').toString().slice(0, 500);\n  if (!out.channel || !out.external_user_id) throw new Error('need channel + external_user_id');\n} else {\n  const digits = ((s) => (s || '').toString().replace(/[^0-9]/g, ''))(b.phone);\n  if (!digits || digits.length < 9) throw new Error('bad phone');\n  const items = Array.isArray(b.items) ? b.items : (Array.isArray(b.lines) ? b.lines : []);\n  if (!items.length) throw new Error('empty items');\n  out.channel = (b.channel || 'shopweb').toString();\n  out.external_user_id = (b.external_user_id || b.userId || '').toString().slice(0, 128);\n  out.name = ((b.name || '').toString().slice(0, 120) || 'ลูกค้า ShopDee');\n  out.phone = digits;\n  out.address = (b.address || '').toString().slice(0, 500);\n  out.note = (b.note || '').toString().slice(0, 500);\n  out.payment = (b.payment || '').toString();\n  out.code = (b.code || '').toString().slice(0, 64);\n  out.total = Number(b.total) || 0;\n  out.items = items.map(function(l){ return { sku: (l.sku || '').toString().slice(0, 64), name: (l.name || '').toString(), price: Number(l.price) || 0, qty: Number(l.qty) || 1 }; });\n}\nreturn [{ json: out }];"
      }
    },
