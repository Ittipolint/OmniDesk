        "jsCode": "const p = $('Shape Job').first().json;\nconst esc = (s) => (s || '').toString().replace(/'/g, \"''\");\nreturn [{ json: { sql: `UPDATE cd_conversations SET bot_enabled = 0 WHERE channel = '${esc(p.channel)}' AND external_user_id = '${esc(p.userId)}'` } }];"
      }
