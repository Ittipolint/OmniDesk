        "jsCode": "const b = $input.first().json.body || $input.first().json || {};\nconst mid = parseInt(b.message_id || b._id) || 0;\nif (!mid) throw new Error('need message_id');\nreturn [{ json: { message_id: mid } }];"
      }
    },
