      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Shape Job').first().json;\nlet pushed = false;\ntry {\n  const t = $('Shape Token').first().json;\n  pushed = !!(t && t.token);\n} catch(e) {}\nreturn [{ json: { ok: true, via: pushed ? 'line' : 'web', channel: p.channel } }];"
