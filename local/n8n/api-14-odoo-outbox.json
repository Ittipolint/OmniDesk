        "jsCode": "const p = $('Shape Job').first().json;\nconst esc = (s) => (s || '').toString().replace(/'/g, \"''\");\nreturn [{ json: { sql: `SELECT COALESCE((SELECT line_channel_token FROM channel_map WHERE channel_code = '${esc(p.channel)}'), '') AS token` } }];"
