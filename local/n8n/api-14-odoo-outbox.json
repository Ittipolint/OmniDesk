        "jsCode": "const r = $input.first().json;\nconst d = (r && r.result !== undefined) ? r.result : r;\nif (!d || d.ok !== true) return [{ json: { skip: true, reason: ((d && d.error) || 'not-a-reply').toString() } }];\nreturn [{ json: { skip: false, channel: d.channel, userId: d.external_user_id,\n  text: d.text, display_name: d.display_name || '', lead_id: d.lead_id || 0 } }];"
      }
    },
