      "name": "Create LINE Message",
      "id": "aaaa1111-2222-3333-4444-555555555501",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst userId = body.userId || '';\nconst type = body.type || 'text';\nconst messages = [];\nif (type === 'image') {\n  const url = body.mediaUrl || '';\n  if (!url) { throw new Error('Missing mediaUrl for image'); }\n  messages.push({ type: 'image', originalContentUrl: url, previewImageUrl: body.mediaPreviewUrl || url });\n} else if (type === 'video') {\n  const url = body.mediaUrl || '';\n  if (!url) { throw new Error('Missing mediaUrl for video'); }\n  messages.push({ type: 'video', originalContentUrl: url, previewImageUrl: body.mediaPreviewUrl || url });\n} else if (type === 'sticker') {\n  const pkg = String(body.stickerPackage || '');\n  const sid = String(body.stickerId || '');\n  if (!pkg || !sid) { throw new Error('Missing sticker package/id'); }\n  messages.push({ type: 'sticker', packageId: pkg, stickerId: sid });\n} else {\n  messages.push({ type: 'text', text: String(body.text || '') });\n}\nif (!userId) { throw new Error('Missing userId'); }\nreturn [{ json: { to: userId, messages: messages, lineToken: (body.lineToken || '').toString() } }];"
      },
      "typeVersion": 2
    },
