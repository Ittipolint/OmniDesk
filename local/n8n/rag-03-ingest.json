        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"content\": {\"parts\": [{\"text\": {{ $json.text.toJsonString() }} }]}, \"taskType\": \"RETRIEVAL_DOCUMENT\", \"outputDimensionality\": 768}"
      }
    },
    {
      "id": "04904b3b-eace-45d8-9a73-78e63de546b4",
      "name": "Join Emb+Chunk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        480
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const chunks = ($('Chunk + Attach Meta').all() || []).map(r => r.json);\nconst embs = ($('Embed Chunk (Gemini 768)').all() || []).map(r => r.json);\nif (!chunks.length || chunks.length !== embs.length) throw new Error('chunk/embed mismatch');\nreturn chunks.map((c, i) => ({ json: { ...c, embedding: embs[i].embedding } }));"
      }
    },
    {
      "id": "4f392958-79a9-445c-9cee-451e872cc510",
      "name": "Build Insert SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const q = (s) => (s || '').toString().replace(/'/g, \"''\");\nconst mk = (m) => {\n  if (!m.embedding || !m.embedding.values) throw new Error('embed ล้มเหลว');\n  const meta = { source_id: (m.metadata||{}).source_id ?? null, group_id: (m.metadata||{}).group_id,\n    group_name: (m.metadata||{}).group_name || '', title: (m.metadata||{}).title || '',\n    image_url: (m.metadata||{}).image_url || null, source_type: (m.metadata||{}).source_type || '',\n    chunk_no: (m.metadata||{}).chunk_no ?? 0 };\n  const vec = '[' + m.embedding.values.join(',') + ']';\n  const sql = `INSERT INTO rag_chunks (source_id, group_id, chunk_no, content, embedding, metadata) VALUES (${meta.source_id ?? 'NULL'}, ${meta.group_id}, ${meta.chunk_no}, '${q(m.text)}', '${vec}'::vector, '${q(JSON.stringify(meta))}'::jsonb)`;\n  return { json: { sql: sql } };\n};\nreturn $input.all().map(r => mk(r.json));"
      }
    },
