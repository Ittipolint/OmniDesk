    {
      "id": "a55c4942-804a-4b59-8410-d78eefbb89d1",
      "name": "Build Gemini OCR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const it = $input.first().json;\nconst bin = $input.first().binary || {};\nconst fname = bin.file ? 'file' : (bin.data ? 'data' : Object.keys(bin)[0]);\nif (!fname) throw new Error('no file binary (field name must be file)');\nconst buf = await this.helpers.getBinaryDataBuffer(0, fname);\nconst f = bin[fname] || {};\nconst prompt = it.kind === 'image'\n  ? 'พากย์ภาพนี้เป็นภาษาไทย 1-2 ประโยค แล้วถอดข้อความตัวอักษรที่เห็นในภาพทั้งหมด (OCR) ตอบเป็นข้อความล้วน'\n  : 'ถอดข้อความทั้งหมดในเอกสาร PDF นี้เป็นภาษาไทย คงโครงสร้างหัวข้อและตัวเลขไว้ครบ ตอบเป็นข้อความล้วน';\nreturn [{ json: { ...it, _mime: f.mimeType || 'application/octet-stream', _data: buf.toString('base64'),\n  _prompt: (it.kind === 'image' && it.text) ? (it.text + '\\n\\n' + prompt) : prompt } }];"
      }
    },
