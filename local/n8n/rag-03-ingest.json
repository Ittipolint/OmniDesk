    {
      "id": "65a54d23-5202-4423-9d2b-4dbcadd5ce32",
      "name": "Shape Local OCR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2120,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const it = $input.first().json;\nconst flags = $('Build Gemini OCR').first().json;\nconst cap = (flags.kind === 'image' && flags.text) ? flags.text.toString().trim() : '';\nlet t = cap ? (cap + '\\n\\n') : '';\ntry { t += (it.text || '').toString(); } catch(e) {}\nif (!t.trim()) throw new Error('OCR ว่างเปล่า');\nreturn [{ json: { kind: flags.kind, group_id: flags.group_id, group_name: flags.group_name,\n  title: flags.title, image_url: flags.image_url, text: t.slice(0, 60000) } }];"
      }
    },
    {
      "id": "3f25d8b6-1ad9-4709-b8d8-8c7fb7ff0527",
      "name": "Set OCR Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1860,
        420
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const it = $input.first().json;\nconst flags = $('Build Gemini OCR').first().json;\nconst cap = (flags.kind === 'image' && flags.text) ? flags.text.toString().trim() : '';\nlet t = cap ? (cap + '\\n\\n') : '';\ntry { t += it.candidates[0].content.parts.map(p => p.text || '').join('\\n'); } catch(e) {}\nif (!t.trim()) throw new Error('OCR ว่างเปล่า');\nreturn [{ json: { kind: flags.kind, group_id: flags.group_id, group_name: flags.group_name,\n  title: flags.title, image_url: flags.image_url, text: t.slice(0, 60000) } }];"
      }
